# Required for a live audit.
SITE_URL=https://example.com

# microCMS Content API. Use a read-only API key for audits.
MICROCMS_SERVICE_DOMAIN=your-service.microcms.io
MICROCMS_READ_API_KEY=replace-with-a-read-only-key
MICROCMS_ARTICLE_ENDPOINT=articles
MICROCMS_FRANCHISE_ENDPOINT=franchise
MICROCMS_MAX_RECORDS=1000

# Optional analytics snapshot exported by your own process.
# Do not commit raw GA4 exports or credentials.
GA4_SNAPSHOT_PATH=

# Optional strategy input. Comma-separated topics are also accepted.
STRATEGY_PATH=content-ops/strategy.json
FOCUS_TOPICS=

# All generated operational files stay under this directory.
OUTPUT_DIR=content-ops
